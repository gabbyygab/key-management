# Copy to .env and fill in your own values. Never commit .env.
SECRET_KEY=FbUAFOHFRawwM26RXAhOVejf79c5GqOJc9vUJCyOdUD5-Yrcs6ZJBhgy2SqPHHsSMVM
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional Supabase mirror (see supabase_sync/README.md). Leave blank to keep it off.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_TIMEOUT=10
SUPABASE_SYNC_ENABLED=False

# Supabase Auth for guard/admin sign-in (see accounts/SUPABASE_AUTH.md).
# SUPABASE_ANON_KEY above takes the anon or sb_publishable_ key; account
# management needs SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_AUTH_ENABLED=False
SUPABASE_AUTH_OFFLINE_FALLBACK=True

# Days an archived building/room/key/category/borrower is kept before
# `manage.py purge_archived` deletes it and everything below it (rooms, keys,
# borrow history). 0 keeps archived rows forever. See accounts/retention.py.
ARCHIVE_RETENTION_DAYS=30

# Password every account made from Users -> Add user starts with.
# Users change it themselves from the key icon in the navbar.
DEFAULT_USER_PASSWORD=Admin2026
